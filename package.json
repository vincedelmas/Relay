{
    "name": "relay",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "browserslist": [
        ">0.3%, defaults, supports es6-module"
    ],
    "scripts": {
        "lint": "oxlint",
        "knip": "knip-bun",
        "test": "bun test",
        "dk": "drizzle-kit",
        "ui": "bunx shadcn@latest",
        "typecheck": "tsc --noEmit",
        "build": "bun --bun vite build",
        "dev": "bun --bun vite dev --port 3000",
        "db:init": "mkdir -p instance && bun run dk migrate",
        "routes:generate": "bun --no-env-file scripts/generate-routes.ts",
        "auth:generate": "bunx --bun auth@1.7.25 generate --yes --config src/lib/server/core/auth.ts --output src/lib/server/database/schema/auth.schema.ts"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@better-auth/cimd": "1.7.25",
        "@better-auth/mcp": "1.7.25",
        "@better-auth/oauth-provider": "1.7.25",
        "@modelcontextprotocol/sdk": "1.32.2",
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/react-query": "^5.108.0",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-start": "^1.169.5",
        "better-auth": "1.7.25",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "drizzle-kit": "1.0.0-rc.5",
        "drizzle-orm": "1.0.0-rc.5",
        "lucide-react": "^1.75.0",
        "pino": "^10.4.0",
        "quickjs-emscripten": "^0.32.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.1.2",
        "@rolldown/plugin-babel": "^0.3.1",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-query-devtools": "^5.108.0",
        "@tanstack/router-generator": "1.168.0",
        "@types/babel__core": "^7.20.5",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
        "knip": "^6.45.1",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2007",
        "pino-pretty": "^13.2.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    }
}
