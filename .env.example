# Public URL of this Relay instance (used by Vite build & OAuth metadata)
VITE_BASE_URL=http://localhost:3000

# SQLite database path
DATABASE_URL=./instance/site.db

# Better Auth signing secret (min 20 chars, generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# Master key for encrypting upstream OAuth tokens in SQLite (32-byte hex or base64)
RELAY_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-chars

# Optional: Steam Web API key (for built-in Steam tools)
STEAM_API_KEY=
STEAM_ID=
